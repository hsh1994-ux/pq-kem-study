# Pinned upstream versions. Every results file records these, so a figure
# can always be traced back to the exact code that produced it.
OPENSSL_TAG=openssl-3.5.8
LIBOQS_TAG=0.16.0
OQSPROVIDER_TAG=0.12.0-rc2   # first tag compatible with liboqs 0.16 (SPHINCS+ removed); 0.11.0 fails to build
DUDECT_COMMIT=dc269651fb2567e46755cfb2a13d3875592968b5  # vendored + patched in ct/dudect/
# pq-crystals Kyber reference code *before* the KyberSlash fixes
# (KyberSlash1 patched 2023-12-01, KyberSlash2 2023-12-30). Used only as a
# positive control in E3; never used for anything else.
KYBER_OLD_COMMIT=4ecce06d584a4e7cecc42f141aadae39b8431b06
# Same Kyber code *after* both KyberSlash fixes (2023-12-29), same API.
KYBER_FIXED_COMMIT=b628ba78711bc28327dc7d2d5c074a00f061884e
